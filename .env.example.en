# ---------------------------------------------------------------------------
# Tikpilot — example configuration file.
# Copy to .env and customize it:  cp .env.example.en .env
# ---------------------------------------------------------------------------

# Session cookie signing key.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty, it will be generated automatically in data/secret.key.
SECRET_KEY=

# Device password encryption key (Fernet, 32 bytes in base64).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, it will be generated automatically in data/fernet.key.
# IMPORTANT: if this key is lost, device passwords cannot be decrypted.
FERNET_KEY=

# Administrator account, created on first launch.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Default interface language: en or ru.
# Each administrator can change it individually; their choice is remembered.
# This variable only determines what users see before changing the language for the first time.
DEFAULT_LANG=en

# Data directory (SQLite database, keys, backups).
DATA_DIR=./data

# --- Panel access ----------------------------------------------------------
# Networks allowed to access the panel itself. Empty means unrestricted.
#
# Useful when the port is exposed to the internet for a public status page:
# the /status/<token> page remains publicly accessible, while panel login and
# all other pages are restricted to these addresses.
#
# Example: ADMIN_NETWORKS=10.0.0.0/8,192.168.0.0/16
ADMIN_NETWORKS=

# Proxies whose X-Forwarded-For header can be trusted.
# This header can be spoofed with a single curl command, so it should only be
# trusted when the request comes from your own proxy. Change this if nginx is
# running on a different machine.
TRUSTED_PROXIES=127.0.0.1,::1

# Address used to access the panel from outside.
# Used only for public status-page links: the server only knows the address
# used to reach it, while the panel is usually opened internally at a
# local address such as 10.x:8080. Sending that link to a contractor is useless.
#
# Example: PUBLIC_BASE_URL=

# Panel address used in invitation links for administrators. The registration
# page is accessible only from a trusted network, so the external address
# from PUBLIC_BASE_URL is not suitable here. Empty means “the address at which
# you are currently accessing the panel”.
# Example: PANEL_BASE_URL=

# Whether to query the address registry (RDAP) for the carrier of sites that
# do not have an LTE modem. This is one of the features that accesses the
# internet, so it is disabled by default. The carrier is always read from the
# modem itself: this is free and requires no external requests.
OPERATOR_LOOKUP=0

# Whether to check once a day for a new panel version. Disabled by default
# for the same reason.
#
# The request contains no data: a standard GET to the public releases page,
# with no version, installation address, or information about your device fleet.
# The panel cannot update itself anyway; installation consists of copying
# files. Enabling this check only displays a notice on the dashboard.
UPDATE_CHECK=0

PANEL_BASE_URL=http://vpn.example.com:6060
PUBLIC_BASE_URL=

# Organization name shown in the availability report header.
# The report is opened using a button on the monitoring page and printed to PDF
# directly from the browser. If empty, the header contains only the report title.
#
# Example: REPORT_TITLE=Example Company, IT Department
REPORT_TITLE=

# Number of days to retain visits through public links.
# The access log contains people's IP addresses and devices, so this retention
# period is separate and shorter than that of the anonymized request counter.
PUBLIC_VIEW_DAYS=90

# Whether to collect a site inventory: ports and their speeds, PoE, bridges and VLANs,
# enabled services, neighbors, and sensor readings.
# Four commands within the same full-polling session; no additional connections
# are created. Disable this if the link is very poor; the device card will then
# show whatever data was collected previously.
INVENTORY_ENABLED=1

# Network
HOST=0.0.0.0
PORT=8080

# Device concurrency and timeouts
MAX_WORKERS=12
API_TIMEOUT=10
FTP_TIMEOUT=30

# Backup file transfer method: auto (SFTP first, FTP as a fallback),
# sftp (SSH only; the FTP service can be disabled on the sites),
# ftp (FTP only, as in versions before 1.75)
BACKUP_TRANSPORT=auto

# Wait time for a device to come back online after reboot (RouterOS update).
REBOOT_INITIAL_DELAY=20
REBOOT_PROBE_INTERVAL=10
# How often to poll the device for the progress of update package downloads.
UPDATE_POLL_INTERVAL=10

# --- Availability monitoring ----------------------------------------------
# 0 — disable background monitoring entirely.
MONITOR_ENABLED=1
# Availability check method:
#   session — persistent API session (recommended). Log in once per device;
#             subsequent checks use a lightweight command over the open connection.
#             The router log is not cluttered and no new connections are created.
#   tcp     — open and close the API port. On low-powered devices this can cause
#             “possible SYN flooding on tcp port 8728” warnings.
MONITOR_PROBE_METHOD=session
MONITOR_INTERVAL=60
MONITOR_PROBE_TIMEOUT=3
MONITOR_SESSION_TIMEOUT=8

# Ping the site from the panel server when its API did not answer. The
# status still means "the API answers", but the card shows whether the
# router is alive at all.
# Ping the site from the server if it does not respond via API. The status
# still refers to API availability, but this shows whether the router itself is alive.
ICMP_CHECK_ENABLED=1
# Full API poll (version, uptime, CPU).
MONITOR_FULL_INTERVAL=900
# Number of consecutive failed checks required to mark a device as unavailable.
# Prevents status flapping on unstable tunnels.
MONITOR_FAIL_THRESHOLD=3
# An outage shorter than this number of seconds is treated as a flap: it is
# not counted as downtime or shown in the event feed, but remains visible in the flapping-sites list.
# 0 — record every outage.
#
# Use 120–300 on poor links. Otherwise, brief one-second drops can generate hundreds
# of history entries per day, making the downtime figure meaningless. The status
# remains accurate: a reachable site is still shown as online.
MONITOR_MIN_OUTAGE=0
# Number of concurrent checks (0 — use the MAX_WORKERS value).
MONITOR_WORKERS=0
# Number of days to retain outage and recovery history.
MONITOR_EVENT_RETENTION_DAYS=30
# How often the interface refreshes the device table, in seconds.
UI_REFRESH_INTERVAL=15

# --- Clients behind routers ------------------------------------------------
# Whether to collect information about devices connected at each site: DHCP leases, ARP, and the
# bridge table. Read within the same full-polling session; no additional connections
# are created. 0 — do not collect.
CLIENTS_ENABLED=1
# Number of days to retain a client that is no longer visible.
# Entries with a custom label are never deleted.
CLIENT_RETENTION_DAYS=30
# Whether to automatically update the MAC vendor database once a month.
VENDORS_AUTO_UPDATE=1


# Session lifetime in seconds (12 hours by default).
SESSION_MAX_AGE=43200
# Session lifetime when “Remember me” is checked on the login page, in seconds.
SESSION_REMEMBER_AGE=2592000

# Number of days to retain job history (0 — keep forever).
JOB_RETENTION_DAYS=90

# How much free space on the panel disk counts as trouble, percent.
# Once it runs out the panel stops writing altogether: no device logs,
# no history, no backups. 0 turns the check off.
# Minimum free space on the panel disk before raising an alert, in percent.
# When the disk runs out of space, the panel stops writing entirely. 0 disables the check.
DISK_MIN_FREE_PERCENT=15

# --- Login protection ------------------------------------------------------
# Number of consecutive failed attempts allowed from one address before
# a temporary lockout is triggered. 0 — no limit.
LOGIN_MAX_ATTEMPTS=5
# Duration of the first lockout in seconds. Each subsequent violation doubles it,
# up to a maximum of one hour. The goal is not to stop a determined attacker, but
# to make brute-force attempts costly.
LOGIN_BLOCK_SECONDS=60

# --- Latency checks --------------------------------------------------------
# Each device pings the configured addresses and reports latency and packet loss.
# This reveals link degradation BEFORE the site goes offline.
LATENCY_ENABLED=1
# Targets shared by the entire fleet. Format: address=label, comma-separated.
# Labels are optional, but make the table easier to read.
#
# The best choice is a central node reachable by every site:
# this is exactly the path used by production traffic. A second target on the internet
# helps distinguish a tunnel issue from a problem with the site's own connection.
# Example: LATENCY_TARGETS=10.0.0.1=hub,8.8.8.8=internet
LATENCY_TARGETS=8.8.8.8
# Whether to ping each site's default gateway (detected automatically).
# Many providers block ICMP traffic to their gateway; set this to 0 in that case.
LATENCY_PING_GATEWAY=1
LATENCY_COUNT=5
# Number of days to retain charts.
METRICS_RETENTION_DAYS=14

# --- Notifications -----------------------------------------------------------
# Off until you turn them on: the panel promises to work in a network with no
# internet, and an outbound request nobody asked for would break that promise.
# Disabled until explicitly enabled: the panel is designed to work on networks without internet access.
NOTIFY_ENABLED=0
# One digest instead of a stream of messages. On a fleet with flapping links
# this is the only mode people still read a month later.
# Send a digest instead of a continuous stream of messages.
NOTIFY_DIGEST_MINUTES=15
# Quiet hours, server time. Equal bounds mean there are none.
# Quiet hours in server time. Equal start and end values mean no quiet hours.
NOTIFY_QUIET_FROM=23
NOTIFY_QUIET_TO=7
# Do not repeat the same rule for the same site more often than this.
# Cooldown for each rule/site pair.
NOTIFY_COOLDOWN_MINUTES=60
# Report a return to normal, not just the alert.
# Notify when service returns to normal, not only when an alert is triggered.
NOTIFY_RESOLVED=1
# Liveness signal. The panel cannot report its own death, so it does the
# opposite: it pings this address regularly, and whoever stops receiving the
# ping raises the alarm. Any watchdog will do: healthchecks.io, your own
# script, a cron job on another machine. Empty means off.
# Heartbeat: the panel periodically pings this address; the receiving service
# raises an alert if the heartbeat stops arriving. Empty means disabled.
HEARTBEAT_URL=
HEARTBEAT_MINUTES=15

# --- Interface throughput ----------------------------------------------------
# Speed is computed from the byte counters read during the full poll: one
# command for every interface, and an average over the interval instead of a
# one second spike. No extra connection to the router is made.
# Speed is calculated from the difference between counters collected during the full poll: one
# command for all interfaces, with an interval average instead of an instantaneous spike.
# No additional connections to the router are created.
TRAFFIC_ENABLED=1
# Watch every interface instead of the uplink and the ones ticked by hand.
# On a box with thirty VLANs this means thirty rows in the database instead
# of one, so turn it on deliberately.
# Monitor all interfaces instead of only the uplink and manually selected ones.
# On a device with thirty VLANs, this means thirty database rows instead of one.
TRAFFIC_ALL_INTERFACES=0

# --- Router logs -------------------------------------------------------------
# The panel listens for syslog and keeps the lines next to everything else.
# The panel listens for syslog messages and stores them alongside the other data.
SYSLOG_ENABLED=1
# High ports by default: 514 needs privileges the service does not have.
# High-numbered ports are used because port 514 requires privileges the service does not have.
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
SYSLOG_BIND=0.0.0.0
# Networks to accept from besides the addresses of known devices. Empty means
# only known devices: syslog is not signed, an open listener fills the disk.
# Networks accepted in addition to the addresses of registered devices. Empty means
# only registered devices are accepted: syslog is unsigned, and an open receiver can fill the disk.
SYSLOG_NETWORKS=
SYSLOG_RETENTION_DAYS=30
SYSLOG_MAX_ROWS=2000000

# --- Terminal ----------------------------------------------------------------
# The full RouterOS command line over SSH. The most dangerous feature of the
# panel: it bypasses the confirmations of bulk actions, so it can be switched
# off entirely, not only by permission.
# Full RouterOS command line over SSH. The panel's most dangerous feature:
# it bypasses bulk-action confirmations, so it can be disabled
# entirely rather than relying on permissions.
TERMINAL_ENABLED=1
TERMINAL_IDLE_MINUTES=15
