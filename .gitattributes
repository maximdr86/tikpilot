# Auto detect text files and perform LF normalization
* text=auto

# cmd.exe разбирает файл построчно и на строке без CR спотыкается: остаток
# файла читается как продолжение предыдущей команды. Полагаться на то, что
# у каждого выставлен core.autocrlf, нельзя, поэтому перевод строки для
# пакетных файлов задан здесь и выдаётся при выгрузке на любой системе.
*.bat text eol=crlf
*.cmd text eol=crlf
