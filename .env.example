# ---------------------------------------------------------------------------
# Tikpilot — пример файла конфигурации.
# Скопируйте в .env и отредактируйте под себя:  cp .env.example .env
# ---------------------------------------------------------------------------

# Ключ подписи сессионных cookie.
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Если оставить пустым — будет создан автоматически в data/secret.key
SECRET_KEY=

# Ключ шифрования паролей устройств (Fernet, 32 байта в base64).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Если оставить пустым — будет создан автоматически в data/fernet.key
# ВАЖНО: при потере ключа расшифровать пароли устройств будет невозможно.
FERNET_KEY=

# Учётная запись администратора, создаётся при первом запуске
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Язык интерфейса по умолчанию: en или ru.
# Каждый администратор может переключить его сам — выбор запоминается.
# Эта переменная задаёт только то, что увидит человек до первого переключения.
DEFAULT_LANG=en

# Каталог с данными (SQLite, ключи, бэкапы)
DATA_DIR=./data

# --- Доступ к панели -------------------------------------------------------
# Сети, из которых открывается сама панель. Пусто — без ограничений.
#
# Нужно, когда порт проброшен наружу ради публичного листа состояния:
# страница /status/<токен> остаётся доступной всем, а вход в панель и всё
# остальное — только с этих адресов.
#
# Пример: ADMIN_NETWORKS=10.0.0.0/8,192.168.0.0/16
ADMIN_NETWORKS=

# Прокси, чьему заголовку X-Forwarded-For можно верить.
# Заголовок подделывается одной строкой в curl, поэтому доверять ему можно
# только когда запрос пришёл от своего же прокси. Меняйте, если nginx стоит
# не на этой машине.
TRUSTED_PROXIES=127.0.0.1,::1

# Адрес, по которому панель видна снаружи.
# Нужен только для публичных ссылок на листы состояния: сервер знает лишь
# адрес, по которому к нему пришли, а панель обычно открывают изнутри по
# локальному 10.x:8080. Такую ссылку подрядчику отправлять бесполезно.
#
# Пример: PUBLIC_BASE_URL=

# Адрес самой панели, для ссылок-приглашений администраторам. Страница
# регистрации открывается только из доверенной сети, поэтому внешний адрес
# из PUBLIC_BASE_URL тут не подходит. Пусто означает «тот адрес, по которому
# вы сейчас смотрите панель».
# Пример: PANEL_BASE_URL=

# Спрашивать ли реестр адресов (RDAP) об операторе тех точек, где нет
# LTE-модема. Единственное место, которое ходит в интернет, поэтому
# по умолчанию выключено. Оператор с модема читается всегда: это
# бесплатно и наружу не ходит.
OPERATOR_LOOKUP=0http://10.10.0.5:6060
PANEL_BASE_URL=http://vpn.example.com:6060
PUBLIC_BASE_URL=

# Название организации в шапке отчёта по доступности.
# Отчёт открывается кнопкой на странице мониторинга и печатается в PDF
# прямо из браузера. Пусто: в шапке будет только название отчёта.
#
# Пример: REPORT_TITLE=ООО «Ромашка», отдел ИТ
REPORT_TITLE=

# Сколько дней хранить заходы по публичным ссылкам.
# В журнале заходов адреса и устройства людей, поэтому срок отдельный
# и короче, чем у обезличенного счётчика обращений.
PUBLIC_VIEW_DAYS=90

# Собирать ли паспорт точки: порты и их скорость, PoE, мосты и VLAN,
# включённые сервисы, соседей, показания датчиков.
# Четыре команды в той же сессии полного опроса, новых подключений
# не создаётся. Выключайте, если канал совсем плох: карточка тогда
# покажет то, что успели собрать раньше.
INVENTORY_ENABLED=1

# Сеть
HOST=0.0.0.0
PORT=8080

# Параллелизм и таймауты работы с устройствами
MAX_WORKERS=12
API_TIMEOUT=10
FTP_TIMEOUT=30

# Ожидание устройства после перезагрузки (обновление RouterOS)
REBOOT_INITIAL_DELAY=20
REBOOT_PROBE_INTERVAL=10
# Как часто спрашивать устройство о ходе загрузки пакетов обновления
UPDATE_POLL_INTERVAL=10

# --- Мониторинг доступности ------------------------------------------------
# 0 — выключить фоновый мониторинг совсем
MONITOR_ENABLED=1
# Способ проверки доступности:
#   session — постоянная API-сессия (рекомендуется). Вход в систему один раз
#             на устройство, дальше дешёвая команда в открытом соединении.
#             Журнал роутера не засоряется, новых подключений не возникает.
#   tcp     — открыть и закрыть порт API. На слабых устройствах вызывает
#             предупреждения «possible SYN flooding on tcp port 8728».
MONITOR_PROBE_METHOD=session
MONITOR_INTERVAL=60
MONITOR_PROBE_TIMEOUT=3
MONITOR_SESSION_TIMEOUT=8
# Полный опрос по API (версия, uptime, CPU)
MONITOR_FULL_INTERVAL=900
# Сколько промахов подряд нужно, чтобы признать устройство недоступным.
# Защита от мигания на нестабильных туннелях.
MONITOR_FAIL_THRESHOLD=3
# Пропадание короче этого числа секунд считается морганием: в простой оно
# не идёт и в ленте событий не появляется, но видно в списке моргающих точек.
# 0 — записывать всё подряд.
#
# Ставьте 120-300 на плохих каналах. Секундные провалы иначе дают сотни строк
# в истории за сутки, и цифра простоя перестаёт что-либо значить. Статус при
# этом остаётся честным: точка на связи показывается на связи.
MONITOR_MIN_OUTAGE=0
# Одновременных проверок (0 — брать значение MAX_WORKERS)
MONITOR_WORKERS=0
# Сколько дней хранить историю падений и подъёмов
MONITOR_EVENT_RETENTION_DAYS=30
# Как часто интерфейс сам перечитывает таблицу устройств, секунд
UI_REFRESH_INTERVAL=15

# --- Клиенты за роутерами ---------------------------------------------------
# Собирать ли то, что подключено к площадкам: аренды DHCP, ARP и таблицу
# моста. Читается в той же сессии полного опроса, новых подключений
# не создаёт. 0 — не собирать.
CLIENTS_ENABLED=1
# Сколько дней помнить клиента, которого больше не видно.
# Строки со своей подписью не удаляются никогда.
CLIENT_RETENTION_DAYS=30
# Обновлять ли базу производителей по MAC самой, раз в месяц
VENDORS_AUTO_UPDATE=1


# Время жизни сессии в секундах (по умолчанию 12 часов)
SESSION_MAX_AGE=43200
# Срок сессии с галочкой «Запомнить меня» на странице входа, секунд
SESSION_REMEMBER_AGE=2592000

# Сколько дней хранить историю задач (0 — хранить вечно)
JOB_RETENTION_DAYS=90

# --- Защита входа ----------------------------------------------------------
# Сколько промахов подряд с одного адреса допустимо, прежде чем включится
# пауза. 0 — не ограничивать.
LOGIN_MAX_ATTEMPTS=5
# Длина первой паузы в секундах. Каждое следующее превышение удваивает её,
# но не больше часа. Смысл не в том, чтобы остановить настойчивого, а в том,
# чтобы перебор перестал быть дешёвым.
LOGIN_BLOCK_SECONDS=60

# --- Проверки задержки -----------------------------------------------------
# Устройство само пингует адреса и сообщает задержку и потери.
# Видно деградацию канала ДО того, как точка отвалится.
LATENCY_ENABLED=1
# Общие цели для всего парка. Формат: адрес=подпись, через запятую.
# Подпись необязательна, но с ней таблица читается лучше.
#
# Лучший выбор — центральный узел, до которого есть маршрут у всех точек:
# это ровно тот путь, по которому идёт рабочий трафик. Вторая цель в интернете
# помогает отличить проблему туннеля от проблемы канала самой площадки.
# Пример: LATENCY_TARGETS=10.0.0.1=хаб,8.8.8.8=интернет
LATENCY_TARGETS=8.8.8.8
# Пинговать ли шлюз по умолчанию каждой точки (определяется автоматически).
# Многие провайдеры блокируют ICMP до своего шлюза — тогда ставьте 0.
LATENCY_PING_GATEWAY=1
LATENCY_COUNT=5
# Сколько дней хранить графики
METRICS_RETENTION_DAYS=14

# --- Notifications / Уведомления ----------------------------------------------
# Off until you turn them on: the panel promises to work in a network with no
# internet, and an outbound request nobody asked for would break that promise.
# Выключено, пока не включите: панель обещает работать в сети без интернета.
NOTIFY_ENABLED=0
# One digest instead of a stream of messages. On a fleet with flapping links
# this is the only mode people still read a month later.
# Сводка вместо потока сообщений.
NOTIFY_DIGEST_MINUTES=15
# Quiet hours, server time. Equal bounds mean there are none.
# Тихие часы по времени сервера. Совпадающие границы означают, что их нет.
NOTIFY_QUIET_FROM=23
NOTIFY_QUIET_TO=7
# Do not repeat the same rule for the same site more often than this.
# Пауза по паре «правило и точка».
NOTIFY_COOLDOWN_MINUTES=60
# Report a return to normal, not just the alert.
# Сообщать о возвращении в норму, а не только о срабатывании.
NOTIFY_RESOLVED=1
# Liveness signal. The panel cannot report its own death, so it does the
# opposite: it pings this address regularly, and whoever stops receiving the
# ping raises the alarm. Any watchdog will do: healthchecks.io, your own
# script, a cron job on another machine. Empty means off.
# Сигнал живости: панель дёргает этот адрес, тревогу поднимает тот, к кому
# сигнал перестал приходить. Пусто значит выключено.
HEARTBEAT_URL=
HEARTBEAT_MINUTES=15

# --- Interface throughput / Трафик на интерфейсах -----------------------------
# Speed is computed from the byte counters read during the full poll: one
# command for every interface, and an average over the interval instead of a
# one second spike. No extra connection to the router is made.
# Скорость считается из разницы счётчиков, снятых при полном обходе: одна
# команда на все интерфейсы и средняя за интервал вместо мгновенного всплеска.
# Отдельных подключений к роутеру не появляется.
TRAFFIC_ENABLED=1
# Watch every interface instead of the uplink and the ones ticked by hand.
# On a box with thirty VLANs this means thirty rows in the database instead
# of one, so turn it on deliberately.
# Следить за всеми интерфейсами, а не только за аплинком и отмеченными руками.
# На коробке с тремя десятками VLAN это тридцать рядов в базе вместо одного.
TRAFFIC_ALL_INTERFACES=0

# --- Journal from the routers / Журнал с роутеров -----------------------------
# The panel listens for syslog and keeps the lines next to everything else.
# Панель слушает syslog и складывает строки рядом со всем остальным.
SYSLOG_ENABLED=1
# High ports by default: 514 needs privileges the service does not have.
# Порты высокие: 514 требует прав, которых у службы нет.
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
SYSLOG_BIND=0.0.0.0
# Networks to accept from besides the addresses of known devices. Empty means
# only known devices: syslog is not signed, an open listener fills the disk.
# Сети, с которых принимать помимо адресов заведённых устройств. Пусто значит
# только от заведённых: syslog не подписан, открытый приёмник забьёт диск.
SYSLOG_NETWORKS=
SYSLOG_RETENTION_DAYS=30
SYSLOG_MAX_ROWS=2000000

# --- Terminal / Терминал ------------------------------------------------------
# The full RouterOS command line over SSH. The most dangerous feature of the
# panel: it bypasses the confirmations of bulk actions, so it can be switched
# off entirely, not only by permission.
# Полная командная строка RouterOS по SSH. Самая опасная возможность панели:
# она обходит подтверждения массовых действий, поэтому её можно выключить
# целиком, не полагаясь на права.
TERMINAL_ENABLED=1
TERMINAL_IDLE_MINUTES=15
